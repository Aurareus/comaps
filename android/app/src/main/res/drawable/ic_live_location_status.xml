    android:pivotX="12"
    android:pivotY="12"
    android:scaleX="1.23"
    android:scaleY="1.23">
    <group
      android:pivotX="12"
      android:pivotY="12"
      android:scaleX="0.62"
      android:scaleY="0.62">
